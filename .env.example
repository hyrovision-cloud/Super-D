# ===============================================
# FRONTEND CONFIGURATION (Vercel / Netlify / Vite)
# ===============================================
# Set this to your deployed backend API URL ending in /api/v1
# Example: https://super-d-api.onrender.com/api/v1
# In local development, leave it empty to use Vite proxy (/api/v1 -> localhost:5000)
VITE_API_BASE_URL=

# ===============================================
# BACKEND CONFIGURATION (Render / Railway / Docker / VPS)
# ===============================================
NODE_ENV=production
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas free cluster)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aarogya_hospital?retryWrites=true&w=majority
MONGODB_URI=

# Security
JWT_SECRET=aarogya-hospital-secret-key-2026-super-speciality-production
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# Google Gemini API Key (Optional: powers Owner Intelligence Assistant)
GEMINI_API_KEY=

# Seed Initial Data (Set to true on initial deploy to load branches, users, patients, roles)
DEMO_MODE=false
FORCE_SEED=true
