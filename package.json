    "test:backend": "npm run test --prefix backend",
    "test": "npm run test --prefix backend",
    "seed:auth": "npm run seed:auth --prefix backend",
    "seed": "npm run seed --prefix backend",
    "seed:verify": "npm run seed:verify --prefix backend"
    ,"test:rbac": "npm run test:rbac --prefix backend"
  }
