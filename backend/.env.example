# ==================================================
# Hospital Management Platform - Backend Environment
# ==================================================

NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/superd_hospital_dev

# Authentication & Security
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=8h

# Cookie Session Configuration
COOKIE_NAME=superd_auth_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS Configuration (Allowed frontend origin)
# In development: http://localhost:3000
# In production: https://hospital-platform.vercel.app
FRONTEND_URL=http://localhost:3000

# AI Microservice URL
AI_SERVICE_URL=http://localhost:5001
